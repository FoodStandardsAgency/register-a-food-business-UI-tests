    "remote:browserstack:wdio": "IS_LOCAL= MODE=BROWSERSTACK wdio run wdio.conf.cjs",
    "test:locally:ui": "yarn run selenium:ui",
    "test:locally:e2e": "yarn run selenium:e2e",
    "test:browserstack:ui": "yarn run remote:browserstack:ui",
    "test:browserstack:e2e": "yarn run browserstack:e2e"
  },
