{
  "name": "register-a-food-business-ui-tests",
  "version": "11.0.0",
  "type": "module",
  "scripts": {
    "test:accessibility": "pa11y-ci",
    "selenium:ui": "IS_LOCAL=true MODE=SELENIUM wdio run wdio.conf.cjs --parallel=true --suite landingpage establishment operator registrationSubmission operatorextra websitefeatures",
    "selenium:e2e": "IS_LOCAL=true MODE=SELENIUM wdio run wdio.conf.cjs --parallel=true --suite end2end",
    "selenium:wdio": "IS_LOCAL=true MODE=SELENIUM wdio run wdio.conf.cjs --parallel=true ",
    "browserstack:ui": "IS_LOCAL=true MODE=BROWSERSTACK wdio run wdio.conf.cjs --suite landingpage establishment operator registrationSubmission operatorextra websitefeatures",
    "browserstack:e2e": "IS_LOCAL=true MODE=BROWSERSTACK wdio run wdio.conf.cjs --suite end2end",
    "browserstack:wdio": "IS_LOCAL=true MODE=BROWSERSTACK wdio run wdio.conf.cjs",
    "remote:browserstack:ui": "IS_LOCAL= MODE=BROWSERSTACK wdio run wdio.conf.js --suite landingpage establishment operator registrationSubmission operatorextra websitefeatures",
